---
// A small torus drawn in Braille dots: each character is a 2x4 grid of dots,
// shaded by ordered dithering. After Andy Sloane's donut.c (2006).
// Spins slowly; drag it to turn it yourself.
---

<pre class="donut" aria-hidden="true" title="Drag me"></pre>

<style>
  .donut {
    margin: 0;
    padding: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    color: var(--muted);
    width: max-content;
    cursor: grab;
    user-select: none;
    touch-action: none;
  }

  .donut:active {
    cursor: grabbing;
  }
</style>

<script>
  const COLS = 18; // characters
  const ROWS = 12;
  const PW = COLS * 2; // dots
  const PH = ROWS * 4;
  const R1 = 1; // tube radius
  const R2 = 2; // distance from the centre of the hole to the tube
  const K2 = 5; // viewer distance
  // Largest projected radius of the torus, in model units: (R1 + R2) / (K2 - R1).
  const MAX_R = (R1 + R2) / (K2 - R1);

  // 4x4 Bayer matrix, normalised to 0..1: turns a brightness into a dot pattern.
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
  // Bit for each dot inside a Braille cell, indexed [row][col].
  const BIT = [
    [0x01, 0x08],
    [0x02, 0x10],
    [0x04, 0x20],
    [0x40, 0x80],
  ];

  const pre = document.querySelector<HTMLPreElement>('.donut');

  if (pre) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Braille dots are not square and their size depends on the font, so measure
    // one dot on screen and scale x and y separately to keep the torus round.
    let kx = 1, ky = 1;
    const measure = () => {
      const rect = pre.getBoundingClientRect();
      const dotW = rect.width / PW;
      const dotH = rect.height / PH;
      if (!dotW || !dotH) return;
      const radiusPx = 0.47 * Math.min(rect.width, rect.height);
      kx = radiusPx / MAX_R / dotW;
      ky = radiusPx / MAX_R / dotH;
    };

    const lum = new Float32Array(PW * PH);
    const depth = new Float32Array(PW * PH);

    let a = 1.0; // rotation about the x axis
    let b = 0.6; // rotation about the z axis
    let va = 0.00045; // radians per millisecond
    let vb = 0.00025;
    const baseVa = va;
    const baseVb = vb;

    const draw = () => {
      lum.fill(-1);
      depth.fill(0);
      const cosA = Math.cos(a), sinA = Math.sin(a);
      const cosB = Math.cos(b), sinB = Math.sin(b);

      for (let theta = 0; theta < 6.283; theta += 0.1) {
        const ct = Math.cos(theta), st = Math.sin(theta);
        for (let phi = 0; phi < 6.283; phi += 0.035) {
          const cp = Math.cos(phi), sp = Math.sin(phi);
          const cx = R2 + R1 * ct;
          const cy = R1 * st;

          const x = cx * (cosB * cp + sinA * sinB * sp) - cy * cosA * sinB;
          const y = cx * (sinB * cp - sinA * cosB * sp) + cy * cosA * cosB;
          const ooz = 1 / (K2 + cosA * cx * sp + cy * sinA);

          const px = Math.floor(PW / 2 + kx * ooz * x);
          const py = Math.floor(PH / 2 - ky * ooz * y);
          if (px < 0 || px >= PW || py < 0 || py >= PH) continue;

          const i = px + PW * py;
          if (ooz > depth[i]) {
            depth[i] = ooz;
            lum[i] =
              cp * ct * sinB - cosA * ct * sp - sinA * st + cosB * (cosA * st - ct * sinA * sp);
          }
        }
      }

      let out = '';
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          let code = 0;
          for (let dy = 0; dy < 4; dy++) {
            for (let dx = 0; dx < 2; dx++) {
              const px = c * 2 + dx, py = r * 4 + dy;
              const l = lum[px + PW * py];
              if (l === -1) continue; // empty space
              // Shadowed side keeps a faint stipple so the silhouette survives.
              const brightness = Math.max(0.06, l / 1.25);
              if (brightness > BAYER[(py % 4) * 4 + (px % 4)]) code |= BIT[dy][dx];
            }
          }
          out += String.fromCharCode(0x2800 + code);
        }
        out += '\n';
      }
      pre.textContent = out;
    };

    // Drag to spin: the pointer sets the speed, then it eases back to its own pace.
    let dragging = false;
    let lastX = 0, lastY = 0, lastT = 0;

    pre.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      lastT = performance.now();
      pre.setPointerCapture(e.pointerId);
    });

    pre.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const now = performance.now();
      const dt = Math.max(1, now - lastT);
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      b += dx * 0.02;
      a += dy * 0.02;
      vb = (dx * 0.02) / dt;
      va = (dy * 0.02) / dt;
      lastX = e.clientX;
      lastY = e.clientY;
      lastT = now;
      if (reduced) draw();
    });

    const release = () => {
      dragging = false;
    };
    pre.addEventListener('pointerup', release);
    pre.addEventListener('pointercancel', release);

    draw(); // first pass gives the box its size
    measure();
    draw();
    new ResizeObserver(() => {
      measure();
      draw();
    }).observe(pre);

    if (!reduced) {
      let visible = true;
      let frame = 0;
      let prev = 0;

      const tick = (t: number) => {
        const dt = prev ? Math.min(t - prev, 50) : 16;
        prev = t;
        if (!dragging) {
          // Ease the speed back towards the resting spin.
          const ease = 1 - Math.exp(-dt / 900);
          va += (baseVa - va) * ease;
          vb += (baseVb - vb) * ease;
          a += va * dt;
          b += vb * dt;
        }
        draw();
        frame = requestAnimationFrame(tick);
      };

      const start = () => {
        if (!frame && visible && !document.hidden) {
          prev = 0;
          frame = requestAnimationFrame(tick);
        }
      };
      const stop = () => {
        cancelAnimationFrame(frame);
        frame = 0;
      };

      // Only spin while on screen and while the tab is in front.
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        visible ? start() : stop();
      }).observe(pre);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    }
  }
</script>
