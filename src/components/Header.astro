---
import { site } from '../site.config';
import { withBase } from '../lib/url';
const path = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? path === full || path === `${full}/` : path.startsWith(full);
};
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase('/')}>{site.title}</a>
    <nav>
      {site.nav.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <button class="theme-toggle" type="button" aria-label="Toggle light and dark theme" title="Light / dark">
        <span class="disc" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
</header>

<style>
  .header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .brand {
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .nav-link {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--fg);
  }

  /* A half-filled disc: the filled side turns over with the theme. */
  .theme-toggle {
    align-self: center;
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    margin-left: -0.25rem;
    background: none;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--fg);
  }

  .disc {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  :global(:root[data-theme="dark"]) .disc {
    transform: rotate(180deg);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private mode: the choice just isn't remembered.
    }
  });
</script>
