---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const items = await getCollection('portfolio', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={item.data.title} description={item.data.description}>
  <article>
    <header class="article-head">
      <h1>{item.data.title}</h1>
      <p>{item.data.description}</p>
      <dl class="facts">
        {item.data.role && (<><dt>Role</dt><dd>{item.data.role}</dd></>)}
        {item.data.client && (<><dt>Client</dt><dd>{item.data.client}</dd></>)}
        {item.data.year && (<><dt>Year</dt><dd class="num">{item.data.year}</dd></>)}
        {item.data.tags.length > 0 && (<><dt>Stack</dt><dd>{item.data.tags.join(', ')}</dd></>)}
        {item.data.url && (
          <>
            <dt>Live</dt>
            <dd><a href={item.data.url} rel="noopener" target="_blank">{item.data.url.replace(/^https?:\/\//, '')}</a></dd>
          </>
        )}
      </dl>
    </header>

    {item.data.image && <img class="cover" src={item.data.image} alt="" />}

    <div class="prose">
      <Content />
    </div>
    <hr />
    <p><a href={withBase('/portfolio')}>← All work</a></p>
  </article>
</BaseLayout>

<style>
  .cover {
    width: 100%;
    border-radius: 4px;
    margin-bottom: 2rem;
  }
</style>
