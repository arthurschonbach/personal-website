---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Donut from '../components/Donut.astro';
import { site } from '../site.config';
import { withBase } from '../lib/url';

const portfolio = (await getCollection('portfolio', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const firstName = site.author.split(' ')[0];
const socials = Object.entries(site.social).filter(([, url]) => url);
const labels: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', x: 'X' };
const featuredWork = (
  portfolio.filter((p) => p.data.featured).length > 0
    ? portfolio.filter((p) => p.data.featured)
    : portfolio
).slice(0, 3);
---

<BaseLayout>
  <h1 class="visually-hidden">{site.author}</h1>
  <section class="intro">
    <div>
      <p>
        Hi, I'm {firstName}. I mostly build ML-related software and occasionally write about it.
        This is where I keep my projects and write-ups.
      </p>
      <p class="muted">
        Find me on
        {socials.map(([name, url], i) => (
          <>
            <a href={url} rel="me noopener" target="_blank">{labels[name] ?? name}</a>{i < socials.length - 1 ? ', ' : ''}
          </>
        ))}
        or send an <a href={`mailto:${site.email}`}>email</a>.
      </p>
    </div>
    <Donut />
  </section>

  <section>
    <h2>Portfolio</h2>
    {featuredWork.length === 0 && <p class="muted">No work yet.</p>}
    <ul class="entries">
      {featuredWork.map((item) => (
        <li>
          <div class="entry-head">
            <a href={withBase(`/portfolio/${item.id}/`)}>{item.data.title}</a>
            <time datetime={item.data.date.toISOString()}>{item.data.year ?? item.data.date.getFullYear()}</time>
          </div>
          <p>{item.data.description}</p>
        </li>
      ))}
    </ul>
    <p class="all"><a href={withBase('/portfolio')}>All work</a></p>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: center;
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 560px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  h2 {
    margin-top: 3rem;
    margin-bottom: 1.25rem;
  }

  .all {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
  }
</style>
