---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { withBase } from '../lib/url';

const portfolio = (await getCollection('portfolio', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featuredWork = (
  portfolio.filter((p) => p.data.featured).length > 0
    ? portfolio.filter((p) => p.data.featured)
    : portfolio
).slice(0, 3);
---

<BaseLayout>
  <section>
    <p>
      Hi, I'm {site.author}. I mostly build ML related software and occasionally write about it. 
      This is where I keep my projects and write-ups.
    </p>
    <p class="muted">
      Find me on
      {Object.entries(site.social)
        .filter(([, url]) => url)
        .map(([name, url], i, arr) => (
          <>
            <a href={url} rel="me noopener" target="_blank">{name}</a>{i < arr.length - 1 ? ', ' : ''}
          </>
        ))}
      or send an <a href={`mailto:${site.email}`}>email</a>.
    </p>
  </section>

  <hr />

  <section>
    <h2>Portfolio</h2>
    {featuredWork.length === 0 && <p class="muted">No work yet.</p>}
    <ul class="list">
      {featuredWork.map((item) => (
        <li>
          <a href={withBase(`/portfolio/${item.id}/`)}>{item.data.title}</a>
          <p class="muted">{item.data.description}</p>
        </li>
      ))}
    </ul>
    <p><a href={withBase('/portfolio')}>All work →</a></p>
  </section>
</BaseLayout>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }

  .list li p {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
  }

  .list li time {
    margin-left: 0.5rem;
  }
</style>
