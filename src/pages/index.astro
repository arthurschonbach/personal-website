---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const portfolio = (await getCollection('portfolio', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const featuredWork = (
  portfolio.filter((p) => p.data.featured).length > 0
    ? portfolio.filter((p) => p.data.featured)
    : portfolio
).slice(0, 3);
---

<BaseLayout>
  <section>
    <h1>{site.author}</h1>
    <p>
      Hi, I'm {site.author}. I build software and occasionally write about it.
      This is where I keep my projects and write-ups.
    </p>
    <p class="muted">
      Find me on
      {Object.entries(site.social)
        .filter(([, url]) => url)
        .map(([name, url], i, arr) => (
          <>
            <a href={url} rel="me noopener" target="_blank">{name}</a>{i < arr.length - 1 ? ', ' : ''}
          </>
        ))}
      or send an <a href={`mailto:${site.email}`}>email</a>.
    </p>
  </section>

  <hr />

  <section>
    <h2>Portfolio</h2>
    {featuredWork.length === 0 && <p class="muted">No work yet.</p>}
    <ul class="list">
      {featuredWork.map((item) => (
        <li>
          <a href={`/portfolio/${item.id}/`}>{item.data.title}</a>
          <p class="muted">{item.data.description}</p>
        </li>
      ))}
    </ul>
    <p><a href="/portfolio">All work →</a></p>
  </section>

  <hr />

  <section>
    <h2>Projects</h2>
    {featured.length === 0 && <p class="muted">No featured projects yet.</p>}
    <ul class="list">
      {featured.map((project) => (
        <li>
          <a href={`/projects/${project.id}/`}>{project.data.title}</a>
          <p class="muted">{project.data.description}</p>
        </li>
      ))}
    </ul>
    <p><a href="/projects">All projects →</a></p>
  </section>

  <hr />

  <section>
    <h2>Recent posts</h2>
    {posts.length === 0 && <p class="muted">No posts yet.</p>}
    <ul class="list">
      {posts.slice(0, 5).map((post) => (
        <li>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toISOString().slice(0, 10)}
          </time>
        </li>
      ))}
    </ul>
    <p><a href="/posts">All posts →</a></p>
  </section>
</BaseLayout>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }

  .list li p {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
  }

  .list li time {
    margin-left: 0.5rem;
  }
</style>
